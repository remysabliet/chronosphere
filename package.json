{
  "name": "memosphere",
  "version": "1.0.0",
  "description": "AI-powered adaptive learning platform",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "build": "pnpm --recursive build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "dev:up": "cd infrastructure/docker && ENVIRONMENT=development docker-compose up -d",
    "dev:down": "cd infrastructure/docker && ENVIRONMENT=development docker-compose down",
    "test:up": "cd infrastructure/docker && ENVIRONMENT=test POSTGRES_PORT=5433 docker-compose up -d postgres",
    "test:down": "cd infrastructure/docker && ENVIRONMENT=test docker-compose down",
    "test:db:setup": "cd infrastructure/docker && ENVIRONMENT=test NODE_ENV=test docker-compose up -d postgres && sleep 5 && cd ../../packages/migration-service && NODE_ENV=test pnpm run migrate:latest && NODE_ENV=test pnpm run seed:run",
    "test:db:teardown": "cd infrastructure/docker && ENVIRONMENT=test docker-compose down",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm --filter @memosphere/* run test:unit",
    "test:integration": "pnpm --filter @memosphere/* run test:integration"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "keywords": [],
  "author": "Rémy SABLIET",
  "license": "ISC"
}