{
  "name": "@memosphere/notification-service",
  "version": "1.0.0",
  "description": "Multi-channel notifications and messaging",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@memosphere/shared": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.2.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "supertest": "^6.0.0",
    "@types/supertest": "^6.0.0"
  }
}
